# Copy to .env and fill in OPENAI_API_KEY. .env is gitignored.
#
# OPENAI_API_KEY powers LLM reasoning, dispatch text-to-SQL, support triage,
# speech recognition (whisper-1), and speech synthesis (tts-1).
#
# src/llm/client.py raises LLMConfigurationError at construction if the key is
# missing. It does not fall back to a stub, because a stub that returns canned
# text is how a broken deployment passes its own health check.

OPENAI_API_KEY=
