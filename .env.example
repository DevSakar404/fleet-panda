# Copy to .env and fill in ONE of these. .env is gitignored.
#
# The provider is whichever key is set (Anthropic wins if both are). Nothing else
# in the codebase knows which one is in use -- see src/llm/client.py.
#
# src/llm/client.py raises LLMConfigurationError at construction if neither is
# present. It does not fall back to a stub, because a stub that returns canned
# text is how a broken deployment passes its own health check.

# VOICE MODE REQUIRES OPENAI_API_KEY specifically. It drives both speech
# recognition (whisper-1) and speech synthesis (tts-1) -- see src/interfaces/
# speech.py. One OpenAI key is therefore enough to run everything; an Anthropic
# key alone runs chat but not voice.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
